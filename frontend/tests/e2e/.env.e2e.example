# Copy this file to .env.e2e and fill in local test credentials.
# Never commit .env.e2e — it is gitignored.

E2E_BASE_URL=http://localhost:5175
E2E_API_BASE_URL=http://127.0.0.1:8000/api

# Optional — Laravel backend database for isolated E2E resets (configure backend .env separately).
# Do NOT run migrate:fresh --seed on cmart_db if it holds manual demo data.
# Create cmart_e2e_db in MySQL, set DB_DATABASE=cmart_e2e_db in backend/.env for E2E runs only.
# DB_DATABASE=cmart_e2e_db

# Community / vendor user (role: community)
E2E_VENDOR_EMAIL=vendor@cmart.com
E2E_VENDOR_PASSWORD=

# Second vendor for Test 7C ownership isolation (seed: vendor_b@cmart.com)
E2E_VENDOR_B_EMAIL=vendor_b@cmart.com
E2E_VENDOR_B_PASSWORD=

# Organizer user (Phase 1.3C — direct booking review)
# Seed: organizer@cmart.com or admin@cmart.com
E2E_ORGANIZER_EMAIL=organizer@cmart.com
E2E_ORGANIZER_PASSWORD=

# CMart management user (Phase 1.3C — venue/activities, no carboot bookings)
# Seed: staff@cmart.com or venue@cmart.com
E2E_CMART_MANAGEMENT_EMAIL=staff@cmart.com
E2E_CMART_MANAGEMENT_PASSWORD=

# Deprecated aliases (optional backward compat — map to organizer/cmart_management above)
# E2E_STAFF_EMAIL=staff@cmart.com
# E2E_STAFF_PASSWORD=
# E2E_MANAGER_EMAIL=admin@cmart.com
# E2E_MANAGER_PASSWORD=

# Optional booking test data (Phase 2)
# Leave E2E_BOOKING_EVENT_NAME empty to use the first available bookable event.
E2E_BOOKING_EVENT_NAME=
E2E_BOOKING_BUSINESS_NAME=E2E Test Vendor
E2E_BOOKING_CATEGORY=Food & Beverages
E2E_BOOKING_DETAILS=Automated Selenium booking test

# Organizer booking review action (optional overrides)
# Safe default: needs_revision
# Supported: needs_revision, approve, reject
E2E_ORGANIZER_BOOKING_ACTION=needs_revision

# Optional: set to true for headless Chrome
# E2E_HEADLESS=false
