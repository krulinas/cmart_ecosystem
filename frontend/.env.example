# Copy to .env.local for local overrides (never commit secrets).

# Laravel API base URL (used for Google OAuth redirect when enabled).
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Show Google sign-in on public /login and /register — requires backend Google OAuth to be configured.
# Must be exactly "true" to enable. Leave unset or false in production until OAuth is ready.
VITE_ENABLE_GOOGLE_LOGIN=false

# Deprecated: demo credential hints are no longer shown in the auth UI.
VITE_SHOW_DEMO_LOGIN_HINTS=false
