{
  "name": "cmart-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --port 5175 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:e2e": "node tests/e2e/run.js",
    "test:e2e:headed": "node tests/e2e/run.js --headed",
    "test:e2e:headless": "node tests/e2e/run.js --headless",
    "test:e2e:phase39": "node tests/e2e/run.js --headless vendor.category-site-selection.spec.js"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@fullcalendar/vue3": "^6.1.20",
    "axios": "^1.16.0",
    "chart.js": "^4.5.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.6",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.5.0",
    "mocha": "^11.7.6",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "postcss": "^8.5.14",
    "prettier": "3.8.3",
    "selenium-webdriver": "^4.45.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
