APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cmart_test
DB_USERNAME=your_test_database_user
DB_PASSWORD=

# Optional overrides for CI or non-default local development database names
# TESTING_APPROVED_DATABASE=cmart_test
# TESTING_DEVELOPMENT_DATABASE=cmart_db

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array

ANALYTICS_API_URL=http://127.0.0.1:8001
ANALYTICS_API_KEY=testing-placeholder-key
